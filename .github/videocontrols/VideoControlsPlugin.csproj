<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>VideoControlsPlugin</AssemblyName>
    <RootNamespace>Ink_Canvas.Plugins.VideoControls</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Platforms>x64;AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>embedded</DebugType>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
  </PropertyGroup>

  <!--
    开发时请把 HintPath 替换为本机上 Ink Canvas Ultra.exe 的输出路径。
    例如：C:\path\to\Ink-Canvas-Ultra\Ink Canvas\bin\Debug\Ink Canvas Ultra.exe
  -->
  <ItemGroup>
    <Reference Include="Ink Canvas Ultra">
      <HintPath>c:\Users\muqiu\Desktop\icu\muqiu-pika\Ink-Canvas-Ultra\Ink Canvas\bin\Debug\Ink Canvas Ultra.exe</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
