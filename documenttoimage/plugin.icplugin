{
  "id": "ink-canvas.document-to-image",
  "name": "文档转照片",
  "version": "3.2.0",
  "author": "muqiu",
  "description": "将 Word / Excel / PDF 文件转换为图片并添加到照片列表，支持本地转换缓存、同名修改检测与文件打开增强（自动启动软件、跳转白板模式、自动转换开关），使用 NPOI 与 PdfiumViewer，无需安装 Microsoft Office。",
  "entryAssembly": "DocumentToImagePlugin.dll",
  "entryClass": "Ink_Canvas.Plugins.DocumentToImage.DocumentToImagePlugin",
  "minHostVersion": "26.8.1"
}