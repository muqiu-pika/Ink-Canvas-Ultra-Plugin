<Window x:Class="Ink_Canvas.Plugins.FunctionGraph.FunctionGraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="函数绘图 · 墨迹公式"
        Width="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PopupWindowBackground}"
        Foreground="{DynamicResource PopupWindowForeground}"
        Topmost="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
    <Border BorderBrush="{DynamicResource PopupWindowBorderBrush}" BorderThickness="1" Padding="18,14">
        <StackPanel>
            <Button x:Name="BtnSystemInk" Content="手写公式（墨迹公式）"
                    Padding="12,6" FontWeight="SemiBold" HorizontalAlignment="Left"
                    MinWidth="220" Click="BtnSystemInk_Click" />
            <TextBlock x:Name="SystemInkHint" Margin="0,6,0,0" FontSize="11"
                       TextWrapping="Wrap" Foreground="#888888" />

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="f(x) =  " VerticalAlignment="Center" FontSize="14"
                           Foreground="{DynamicResource PopupWindowForeground}" />
                <TextBox x:Name="ExpressionBox" Width="440" Height="28" VerticalContentAlignment="Center"
                         FontSize="14" TextChanged="ExpressionBox_TextChanged" />
            </StackPanel>

            <TextBlock x:Name="StatusText" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource PopupWindowForeground}" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="x 轴最大范围：" VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource PopupWindowForeground}" />
                <TextBox Grid.Column="1" x:Name="XMaxBox" Height="26" Text="5" VerticalContentAlignment="Center" />
                <TextBlock Grid.Column="2" Text="  y 轴最大范围：" VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource PopupWindowForeground}" />
                <TextBox Grid.Column="3" x:Name="YMaxBox" Height="26" Text="25" VerticalContentAlignment="Center" />
                <CheckBox Grid.Column="4" x:Name="TicksCheck" Content="显示刻度" IsChecked="True"
                          Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13"
                          Foreground="{DynamicResource PopupWindowForeground}" />
                <CheckBox Grid.Column="5" x:Name="GridCheck" Content="显示网格线" IsChecked="True"
                          Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"
                          Foreground="{DynamicResource PopupWindowForeground}" />
            </Grid>

            <TextBlock Text="# 范围以中心对称，每格 1 单位。"
                       FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource PopupWindowForeground}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="确定" Padding="18,4" Margin="0,0,10,0" IsDefault="True" Click="BtnOk_Click" />
                <Button Content="取消" Padding="18,4" IsCancel="True" Click="BtnCancel_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
