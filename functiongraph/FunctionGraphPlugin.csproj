<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>FunctionGraphPlugin</AssemblyName>
    <RootNamespace>Ink_Canvas.Plugins.FunctionGraph</RootNamespace>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <FileVersion>1.3.1.0</FileVersion>
    <Platforms>x64;AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>embedded</DebugType>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- 宿主程序集：提供 IPlugin / IPluginHost / PluginManifest 契约。
         插件复用宿主已加载的程序集（Private=false），因此除自身 DLL 外不打包任何额外依赖。 -->
    <Reference Include="Ink Canvas Ultra">
      <HintPath>..\..\Ink-Canvas-Ultra\Ink Canvas\bin\Release\Ink Canvas Ultra.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 手写公式识别：System.Windows.Ink.InkAnalyzer 在 IAWinFX/IACore 中，
         宿主主程序已随包分发这两个 DLL（Private=false，运行时由宿主提供） -->
    <Reference Include="IAWinFX">
      <HintPath>..\..\Ink-Canvas-Ultra\Ink Canvas\IAWinFX.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="IACore">
      <HintPath>..\..\Ink-Canvas-Ultra\Ink Canvas\IACore.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 插件清单与打包脚本 -->
    <None Include="plugin.icplugin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="pack.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
